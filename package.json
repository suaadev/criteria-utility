{
  "name": "@sudavz/criteria",
  "version": "0.1.0-alpha.3",
  "description": "A TypeScript library for building decoupled search and filtering criteria using the Criteria pattern.",
  "license": "MIT",
  "author": "David Suarez sudavz@proton.me",
  "type": "module",
  "main": "./lib/index.js",
  "private": "false",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write --config .prettierrc .",
    "prepare": "husky",
    "lint": "eslint ."
  },
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@swc/jest": "^0.2.39",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
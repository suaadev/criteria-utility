{
    "compilerOptions": {
        "module": "commonjs",
        "rootDir": ".",
        "outDir": "./lib",
        "noImplicitAny": true,
        "skipLibCheck": true,
        "types": [
            "node"
        ],
        "strictNullChecks": true,
    },
    "exclude": [
        "node_modules",
        "**/*.spec.ts",
        "**/*.test.ts",
        "tests"
    ],
    "include": [
        "src/**/*"
    ],
}
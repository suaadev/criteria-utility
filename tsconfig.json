{
  "compilerOptions": {
    "declaration": true,
    "removeComments": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./lib",
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": ["node"],
    "strictNullChecks": true
  },
  "exclude": ["node_modules"],
  "include": ["src/**/*.ts"]
}
